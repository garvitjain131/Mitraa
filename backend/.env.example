# Copy to backend/.env and fill in. Never commit .env.

# --- Nemotron via Nebius Token Factory (OpenAI-compatible API) ---
NEBIUS_API_KEY=
# OpenAI-compatible base URL from your Nebius console (ends in /v1/),
# e.g. https://api.studio.nebius.com/v1/
NEBIUS_BASE_URL=
# Exact Nemotron model id from the Nebius model catalog,
# e.g. nvidia/Llama-3_3-Nemotron-Super-49B-v1_5
NEMOTRON_MODEL=

# --- Mitraa ---
# Semicolon-separated folders Mitraa may touch. Everything else is blocked.
MITRAA_ALLOWED_ROOTS=~/Documents;~/Downloads;~/Desktop
# Max LLM calls per user request (stops runaway loops).
MITRAA_MAX_STEPS=8
# Actions touching more files than this need approval.
MITRAA_BULK_THRESHOLD=5
# Optional: database location (default: backend/mitraa.db)
# MITRAA_DB_URL=sqlite:///C:/Users/you/.mitraa/mitraa.db

# --- Desktop assistant (python -m mitraa.assistant) ---
# Hold any of these keys (comma-separated) to summon the pop-up.
# Names: ctrl (either side), ctrl_l, ctrl_r, alt_r, shift_r, menu, pause, f1..f24
# Raw codes: vk:255, scan:99, vk:255/scan:99 (find yours with: python -m mitraa.assistant --detect)
# Ctrl only counts when held alone, so shortcuts like Ctrl+C never trigger it.
MITRAA_HOTKEY=ctrl
MITRAA_HOLD_SECONDS=3

# --- Voice ---
# Talk after summoning; Mitraa listens until you stop, then acts and answers out loud.
MITRAA_VOICE_INPUT=true
MITRAA_VOICE_OUTPUT=true
# Whisper model (multilingual): tiny | base | small | medium. small is a good balance.
MITRAA_STT_MODEL=small
# auto = GPU if CUDA libraries work (see requirements-gpu.txt), else CPU
MITRAA_STT_DEVICE=auto
# Empty = auto-detect English / Hindi / Hinglish. Or force e.g. en, hi
MITRAA_STT_LANGUAGE=
# Part of a Windows voice name: Heera, Ravi (English-India), Zira, Hazel...
MITRAA_TTS_VOICE=Heera
MITRAA_TTS_RATE=1
